COMPUST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/compust
COMPUST_DB_POOL_PRE_PING=true
COMPUST_APP_NAME=Compust API
COMPUST_DEBUG=false

# Allowed browser extension origins (comma-separated, no wildcards)
# In Chrome: chrome-extension://<EXTENSION_ID> (found at chrome://extensions after loading unpacked)
# In Firefox: moz-extension://compust-capture@compust.ma (matches manifest browser_specific_settings.gecko.id)
COMPUST_EXTENSION_ORIGINS=chrome-extension://compustcaptureextensionid,moz-extension://compust-capture@compust.ma
